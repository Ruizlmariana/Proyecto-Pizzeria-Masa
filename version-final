/* Matriz de ventas: dias de la semana (filas) x tipos de producto (columnas) */
void reporteVentasPorDia(void) {
    int f, c, totalFila, totalGeneral = 0;
    int totalesCol[TIPOS_PRODUCTO] = {0};

    printf("\n*** VENTAS ENTREGADAS POR DIA DE LA SEMANA Y TIPO DE PRODUCTO ***\n");
    printf("%-12s %8s %8s %8s %8s %8s\n",
           "Dia", "Pizzas", "Bebidas", "Postres", "Combos", "Total");

    for (f = 0; f < DIAS; f++) {
        totalFila = 0;
        for (c = 0; c < TIPOS_PRODUCTO; c++) {
            totalFila += matrizVentas[f][c];
            totalesCol[c] += matrizVentas[f][c];
        }
        printf("%-12s %8d %8d %8d %8d %8d\n",
               nombreDia(f),
               matrizVentas[f][0], matrizVentas[f][1],
               matrizVentas[f][2], matrizVentas[f][3],
               totalFila);
        totalGeneral += totalFila;
    }

    printf("%-12s %8d %8d %8d %8d %8d\n",
           "TOTAL",
           totalesCol[0], totalesCol[1], totalesCol[2], totalesCol[3],
           totalGeneral);
}

/* Vector de acumulados + ordenamiento burbuja (descendente) */
void reporteProductosMasVendidos(void) {
    int unidades[MAX_PRODUCTOS] = {0};
    int importe[MAX_PRODUCTOS]  = {0};
    int orden[MAX_PRODUCTOS];
    int i, j, aux, idxProd, totalUnidades = 0;

    if (cantPedidos == 0) {
        printf("Todavia no hay pedidos para analizar.\n");
        return;
    }

    /* Se acumulan unidades e importes por producto (sin cancelados) */
    for (i = 0; i < cantPedidos; i++) {
        if (pedidos[i].estado == 3)
            continue;
        for (j = 0; j < pedidos[i].cantItems; j++) {
            idxProd = buscarProductoPorId(pedidos[i].detalle[j].idProducto);
            if (idxProd != -1) {
                unidades[idxProd] += pedidos[i].detalle[j].cantidad;
                importe[idxProd]  += pedidos[i].detalle[j].subtotal;
            }
        }
    }

    for (i = 0; i < cantProductos; i++)
        orden[i] = i;

    /* Ordenamiento burbuja por unidades vendidas (mayor a menor) */
    for (i = 0; i < cantProductos - 1; i++)
        for (j = 0; j < cantProductos - 1 - i; j++)
            if (unidades[orden[j]] < unidades[orden[j + 1]]) {
                aux = orden[j];
                orden[j] = orden[j + 1];
                orden[j + 1] = aux;
            }

    printf("\n*** PRODUCTOS MAS VENDIDOS (sin pedidos cancelados) ***\n");
    printf("%-4s %-24s %10s %12s\n", "Pos", "Producto", "Unidades", "Importe");

    for (i = 0; i < cantProductos; i++) {
        printf("%-4d %-24.24s %10d $%11d\n",
               i + 1,
               productos[orden[i]].nombre,
               unidades[orden[i]],
               importe[orden[i]]);
        totalUnidades += unidades[orden[i]];
    }
    printf("%-4s %-24s %10d\n", "", "TOTAL UNIDADES", totalUnidades);
}

void reporteFacturacion(void) {
    int i, cnt = 0, total = 0, promedio = 0;
    int maxTotal = -1, minTotal = -1;
    int numMax = -1, numMin = -1;

    if (cantPedidos == 0) {
        printf("Todavia no hay pedidos para facturar.\n");
        return;
    }

    for (i = 0; i < cantPedidos; i++) {
        if (pedidos[i].estado == 3)   /* cancelados no facturan */
            continue;

        cnt++;
        total += pedidos[i].total;

        if (pedidos[i].total > maxTotal) {
            maxTotal = pedidos[i].total;
            numMax = pedidos[i].numero;
        }
        if (minTotal == -1 || pedidos[i].total < minTotal) {
            minTotal = pedidos[i].total;
            numMin = pedidos[i].numero;
        }
    }

    printf("\n*** RESUMEN DE FACTURACION ***\n");

    if (cnt == 0) {
        printf("No hay pedidos facturables (todos fueron cancelados).\n");
        return;
    }

    promedio = total / cnt;   /* division entera */

    printf("Pedidos considerados : %d\n", cnt);
    printf("Facturacion total    : $%d\n", total);
    printf("Promedio por pedido  : $%d\n", promedio);
    printf("Pedido de mayor valor: Nro %d ($%d)\n", numMax, maxTotal);
    printf("Pedido de menor valor: Nro %d ($%d)\n", numMin, minTotal);
}

void reportePedidosPorEstado(void) {
    int cuenta[ESTADOS] = {0};
    int i, total, porcentaje;

    if (cantPedidos == 0) {
        printf("Todavia no hay pedidos registrados.\n");
        return;
    }

    for (i = 0; i < cantPedidos; i++)
        cuenta[pedidos[i].estado]++;

    total = cantPedidos;

    printf("\n*** PEDIDOS POR ESTADO ***\n");
    printf("%-18s %10s %10s\n", "Estado", "Cantidad", "Porcentaje");

    for (i = 0; i < ESTADOS; i++) {
        porcentaje = cuenta[i] * 100 / total;   /* porcentaje entero */
        printf("%-18s %10d %9d%%\n", nombreEstado(i), cuenta[i], porcentaje);
    }
    printf("%-18s %10d %9d%%\n", "TOTAL", total, 100);
}

/* Matriz de pedidos por empleado (filas) y estado (columnas) */
void reporteEmpleados(void) {
    int i, j;

    if (cantEmpleados == 0) {
        printf("No hay empleados cargados.\n");
        return;
    }

    printf("\n*** RENDIMIENTO DE EMPLEADOS ***\n");
    printf("%-20s %9s %9s %9s %9s %13s\n",
           "Empleado", "Pendien.", "Prepar.", "Entreg.", "Cancel.", "Entregados");

    for (i = 0; i < cantEmpleados; i++) {
        printf("%-20.20s", empleados[i].nombre);
        for (j = 0; j < ESTADOS; j++)
            printf(" %8d", matrizPedidosEmpleado[i][j]);
        printf(" %12d\n", empleados[i].pedidosEntregados);
    }
}

