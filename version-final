/* Deja la entrada estandar sin datos pendientes */
void limpiarBuffer(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF) {
    }
}

/* Detiene la pantalla hasta que el usuario presiona ENTER */
void pausa(void) {
    int c;
    printf("\nPresione ENTER para continuar...");
    while ((c = getchar()) != '\n' && c != EOF) {
    }
    printf("\n");
}

/* Lee y valida un numero entero dentro del rango [min, max] */
int leerEntero(char mensaje[], int min, int max) {
    int valor, r;

    printf("%s", mensaje);
    r = scanf("%d", &valor);

    while (r != 1 || valor < min || valor > max) {
        if (r == EOF) {
            printf("\n[Entrada de datos finalizada. Saliendo del sistema...]\n");
            exit(0);
        }
        if (r != 1)
            printf("Debe ingresar un numero entero. ");
        else
            printf("Valor fuera del rango [%d - %d]. ", min, max);

        limpiarBuffer();
        printf("%s", mensaje);
        r = scanf("%d", &valor);
    }

    limpiarBuffer();
    return valor;
}

/* Lee una cadena de texto (con espacios) */
void leerTexto(char mensaje[], char destino[], int max) {
    int len;

    printf("%s", mensaje);
    if (fgets(destino, max, stdin) == NULL) {
        destino[0] = '\0';
        return;
    }
    len = (int) strlen(destino);
    if (len > 0 && destino[len - 1] == '\n')
        destino[len - 1] = '\0';
}

/* Devuelve el nombre del tipo de producto */
const char *nombreTipo(int tipo) {
    switch (tipo) {
        case 1:  return "Pizza";
        case 2:  return "Bebida";
        case 3:  return "Postre";
        case 4:  return "Combo";
        default: return "Otro";
    }
}

/* Devuelve el nombre del estado del pedido */
const char *nombreEstado(int estado) {
    switch (estado) {
        case 0:  return "Pendiente";
        case 1:  return "En preparacion";
        case 2:  return "Entregado";
        case 3:  return "Cancelado";
        default: return "Indefinido";
    }
}

/* dia = 0 (lunes) ... 6 (domingo) */
const char *nombreDia(int dia) {
    static const char *dias[DIAS] = {
        "Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado", "Domingo"
    };
    if (dia < 0 || dia >= DIAS) return "?";
    return dias[dia];
}

/* Calcula el dia de la semana de una fecha (algoritmo de Sakamoto).
 * Devuelve 0 = lunes ... 6 = domingo. Ejemplo: enteros. */
int diaDeLaSemana(int dia, int mes, int anio) {
    static int t[12] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};
    int a = anio;
    int d;

    if (mes < 3)
        a -= 1;

    d = (a + a / 4 - a / 100 + a / 400 + t[mes - 1] + dia) % 7; /* 0 = domingo */

    return (d + 6) % 7;  /* 0 = lunes */
}

