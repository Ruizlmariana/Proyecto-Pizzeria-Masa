/* Suma los subtotales del detalle del pedido (enteros) */
int calcularTotalPedido(DetallePedido detalle[], int cant) {
    int i, total = 0;

    for (i = 0; i < cant; i++)
        total += detalle[i].subtotal;

    return total;
}

void crearPedido(void) {
    Pedido p;
    int items, i, idxProd, idxEmp;
    int idCliente, idEmpleado, idProducto, cantidad, descuento, total;

    if (cantClientes == 0) {
        printf("Primero debe registrar al menos un cliente (menu 2).\n");
        return;
    }
    if (cantProductos == 0) {
        printf("No hay productos en la carta.\n");
        return;
    }
    if (cantPedidos >= MAX_PEDIDOS) {
        printf("No hay espacio para mas pedidos (maximo %d).\n", MAX_PEDIDOS);
        return;
    }

    printf("\n================ NUEVO PEDIDO ================\n");

    /* --- 1) Cliente --- */
    mostrarClientes();
    do {
        idCliente = leerEntero("ID del cliente: ", 1, 999999);
        if (buscarClientePorId(idCliente) == -1)
            printf("No existe un cliente con ese ID.\n");
    } while (buscarClientePorId(idCliente) == -1);

    /* --- 2) Productos del pedido --- */
    mostrarProductos();
    items = leerEntero("Cantidad de items del pedido (1-10): ", 1, MAX_DETALLE);

    p.cantItems = 0;
    for (i = 0; i < items; i++) {
        printf("\nItem %d:\n", i + 1);
        do {
            idProducto = leerEntero("  ID del producto: ", 1, 999999);
            idxProd = buscarProductoPorId(idProducto);
            if (idxProd == -1)
                printf("  No existe un producto con ese ID.\n");
            else if (!productos[idxProd].disponible)
                printf("  El producto no esta disponible.\n");
        } while (idxProd == -1 || !productos[idxProd].disponible);

        cantidad = leerEntero("  Cantidad: ", 1, 99);

        p.detalle[p.cantItems].idProducto = idProducto;
        p.detalle[p.cantItems].cantidad   = cantidad;
        p.detalle[p.cantItems].subtotal   = productos[idxProd].precio * cantidad;
        p.cantItems++;
    }

    /* --- 3) Empleado que prepara el pedido --- */
    mostrarEmpleados();
    do {
        idEmpleado = leerEntero("ID del empleado que prepara el pedido: ", 1, 999999);
        if (buscarEmpleadoPorId(idEmpleado) == -1)
            printf("No existe un empleado con ese ID.\n");
    } while (buscarEmpleadoPorId(idEmpleado) == -1);

    /* --- 4) Fecha (enteros) --- */
    p.dia  = leerEntero("Dia (1-31): ", 1, 31);
    p.mes  = leerEntero("Mes (1-12): ", 1, 12);
    p.anio = leerEntero("Anio (2020-2035): ", 2020, 2035);

    /* --- 5) Descuento y total --- */
    descuento = leerEntero("Descuento a aplicar % (0-50): ", 0, 50);
    total = calcularTotalPedido(p.detalle, p.cantItems);
    total = total - total * descuento / 100;   /* descuento entero */

    /* --- 6) Cabecera del pedido --- */
    p.numero    = siguienteNumeroPedido;
    p.idCliente = idCliente;
    p.idEmpleado = idEmpleado;
    p.estado    = 0;   /* siempre arranca pendiente */
    p.total     = total;

    /* --- 7) Alta en el vector de pedidos --- */
    pedidos[cantPedidos] = p;
    cantPedidos++;
    siguienteNumeroPedido++;

    /* --- 8) Se registra en la matriz de pedidos por empleado --- */
    idxEmp = buscarEmpleadoPorId(idEmpleado);
    matrizPedidosEmpleado[idxEmp][0]++;   /* estado pendiente */

    /* --- Resumen por pantalla --- */
    idxEmp = buscarEmpleadoPorId(idEmpleado);
    printf("\n==============================================\n");
    printf(" Pedido Nro %d registrado con exito.\n", p.numero);
    printf(" Cliente : %s\n", clientes[buscarClientePorId(idCliente)].nombre);
    printf(" Empleado: %s\n", empleados[idxEmp].nombre);
    printf(" Fecha   : %02d/%02d/%d (%s)\n",
           p.dia, p.mes, p.anio, nombreDia(diaDeLaSemana(p.dia, p.mes, p.anio)));
    printf(" Items   : %d\n", p.cantItems);
    printf(" Descuento aplicado: %d%%\n", descuento);
    printf(" TOTAL   : $%d\n", p.total);
    printf("==============================================\n");

    pausa();
}

void mostrarPedido(int indice) {
    Pedido *p = &pedidos[indice];
    int i, idxCli, idxEmp, idxProd;

    idxCli = buscarClientePorId(p->idCliente);
    idxEmp = buscarEmpleadoPorId(p->idEmpleado);

    printf("\n=============== PEDIDO NRO %d ===============\n", p->numero);
    printf("Cliente  : %s (ID %d)\n",
           idxCli != -1 ? clientes[idxCli].nombre : "Desconocido", p->idCliente);
    printf("Empleado : %s (ID %d)\n",
           idxEmp != -1 ? empleados[idxEmp].nombre : "Desconocido", p->idEmpleado);
    printf("Fecha    : %02d/%02d/%d (%s)\n",
           p->dia, p->mes, p->anio, nombreDia(diaDeLaSemana(p->dia, p->mes, p->anio)));
    printf("Estado   : %s\n", nombreEstado(p->estado));
    printf("----------------------------------------------\n");

    for (i = 0; i < p->cantItems; i++) {
        idxProd = buscarProductoPorId(p->detalle[i].idProducto);
        printf("  %d) %-24.24s x %-3d  $%d\n",
               i + 1,
               idxProd != -1 ? productos[idxProd].nombre : "Producto",
               p->detalle[i].cantidad,
               p->detalle[i].subtotal);
    }

    printf("----------------------------------------------\n");
    printf("  TOTAL: $%d\n", p->total);
    printf("==============================================\n");
}

void listarPedidos(void) {
    int i, idxCli, idxEmp;

    if (cantPedidos == 0) {
        printf("Todavia no hay pedidos registrados.\n");
        return;
    }

    printf("\n+------+------------+----------------------+----------------------+------------------+----------+\n");
    printf("| %-4s | %-10s | %-20s | %-20s | %-16s | %8s |\n",
           "Nro", "Fecha", "Cliente", "Empleado", "Estado", "Total");
    printf("+------+------------+----------------------+----------------------+------------------+----------+\n");

    for (i = 0; i < cantPedidos; i++) {
        idxCli = buscarClientePorId(pedidos[i].idCliente);
        idxEmp = buscarEmpleadoPorId(pedidos[i].idEmpleado);
        printf("| %-4d | %02d/%02d/%d | %-20.20s | %-20.20s | %-16s | $%7d |\n",
               pedidos[i].numero,
               pedidos[i].dia, pedidos[i].mes, pedidos[i].anio,
               idxCli != -1 ? clientes[idxCli].nombre : "?",
               idxEmp != -1 ? empleados[idxEmp].nombre : "?",
               nombreEstado(pedidos[i].estado),
               pedidos[i].total);
    }
    printf("+------+------------+----------------------+----------------------+------------------+----------+\n");
}

int buscarPedidoPorNumero(int numero) {
    int i;
    for (i = 0; i < cantPedidos; i++)
        if (pedidos[i].numero == numero)
            return i;
    return -1;
}

void cambiarEstadoPedido(void) {
    int numero, idx, idxEmp, nuevo, i, fila;

    if (cantPedidos == 0) {
        printf("Todavia no hay pedidos registrados.\n");
        return;
    }

    listarPedidos();
    printf("\n--- CAMBIO DE ESTADO DE UN PEDIDO ---\n");

    do {
        numero = leerEntero("Numero de pedido (0 para cancelar): ", 0, 999999);
        if (numero == 0) return;
        idx = buscarPedidoPorNumero(numero);
        if (idx == -1)
            printf("No existe el pedido Nro %d.\n", numero);
    } while (idx == -1);

    mostrarPedido(idx);

    if (pedidos[idx].estado == 2 || pedidos[idx].estado == 3) {
        printf("El pedido esta en estado final (%s): no se puede modificar.\n",
               nombreEstado(pedidos[idx].estado));
        return;
    }

    printf("Estados: 0-Pendiente  1-En preparacion  2-Entregado  3-Cancelado\n");
    do {
        nuevo = leerEntero("Nuevo estado: ", 0, 3);
        if (nuevo == pedidos[idx].estado)
            printf("Ese ya es el estado actual del pedido.\n");
    } while (nuevo == pedidos[idx].estado);

    idxEmp = buscarEmpleadoPorId(pedidos[idx].idEmpleado);

    /* Se actualiza la matriz de pedidos por empleado y estado */
    matrizPedidosEmpleado[idxEmp][pedidos[idx].estado]--;
    matrizPedidosEmpleado[idxEmp][nuevo]++;

    /* Al entregar: se acumulan el empleado y la matriz de ventas por dia */
    if (nuevo == 2) {
        empleados[idxEmp].pedidosEntregados++;
        fila = diaDeLaSemana(pedidos[idx].dia, pedidos[idx].mes, pedidos[idx].anio);
        for (i = 0; i < pedidos[idx].cantItems; i++) {
            int tipo = buscarProductoPorId(pedidos[idx].detalle[i].idProducto);
            if (tipo != -1)
                matrizVentas[fila][productos[tipo].tipo - 1] += pedidos[idx].detalle[i].cantidad;
        }
    }

    pedidos[idx].estado = nuevo;

    printf("\nPedido Nro %d ahora esta en estado: %s\n",
           pedidos[idx].numero, nombreEstado(pedidos[idx].estado));

    pausa();
}

