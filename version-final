#define TIPOS_PRODUCTO       4   /* pizza, bebida, postre, combo */
#define ESTADOS              4   /* pendiente, preparacion, entregado, cancelado */

/* ========================== ESTRUCTURAS ================================== */

/* Producto de la carta (pizza, bebida, postre o combo) */
typedef struct {
    int  id;
    char nombre[40];
    int  tipo;        /* 1 = pizza, 2 = bebida, 3 = postre, 4 = combo */
    int  precio;      /* precio en pesos enteros */
    int  disponible;  /* 1 = si, 0 = no (baja logica) */
} Producto;

/* Cliente registrado */
typedef struct {
    int  id;
    char nombre[40];
    char direccion[60];
    int  telefono;
    int  dni;
} Cliente;

/* Empleado que prepara / entrega pedidos */
typedef struct {
    int  id;
    char nombre[40];
    int  turno;             /* 1, 2 o 3 */
    int  dni;
    int  pedidosEntregados; /* acumulado de pedidos entregados */
} Empleado;

/* Linea (renglon) del detalle de un pedido */
typedef struct {
    int idProducto;
    int cantidad;
    int subtotal;           /* precio * cantidad */
} DetallePedido;

/* Pedido completo */
typedef struct {
    int  numero;            /* numero unico de pedido (autoincremental) */
    int  idCliente;
    int  idEmpleado;
    int  dia, mes, anio;    /* fecha en enteros */
    int  estado;            /* 0 pendiente, 1 preparacion, 2 entregado, 3 cancelado */
    DetallePedido detalle[MAX_DETALLE];
    int  cantItems;
    int  total;             /* total a pagar (entero) */
} Pedido;

