void cargarProductosIniciales(void) {
    Producto ejemplos[] = {
        {1, "Pizza Muzzarella",       1, 8500,  1},
        {2, "Pizza Pepperoni",        1, 9500,  1},
        {3, "Pizza Fugazzeta",        1, 9000,  1},
        {4, "Pizza Jamon y Morron",   1, 9800,  1},
        {5, "Coca Cola 2 litros",     2, 3500,  1},
        {6, "Agua mineral 500 cc",    2, 2000,  1},
        {7, "Fain casero",            3, 2500,  1},
        {8, "Combo individual",       4, 12000, 1}
    };
    int i;
    int n = (int) (sizeof(ejemplos) / sizeof(ejemplos[0]));

    for (i = 0; i < n && i < MAX_PRODUCTOS; i++)
        productos[i] = ejemplos[i];

    cantProductos = n;
    siguienteIdProducto = n + 1;
}

void mostrarProductos(void) {
    int i;

    if (cantProductos == 0) {
        printf("No hay productos cargados.\n");
        return;
    }

    printf("\n+------+----------------------+----------+------------+--------------+\n");
    printf("| %-4s | %-20s | %-8s | %10s | %-12s |\n",
           "ID", "Nombre", "Tipo", "Precio", "Estado");
    printf("+------+----------------------+----------+------------+--------------+\n");

    for (i = 0; i < cantProductos; i++) {
        printf("| %-4d | %-20.20s | %-8s | $%9d | %-12s |\n",
               productos[i].id,
               productos[i].nombre,
               nombreTipo(productos[i].tipo),
               productos[i].precio,
               productos[i].disponible ? "Disponible" : "No disponible");
    }
    printf("+------+----------------------+----------+------------+--------------+\n");
}

/* Devuelve el INDICE del vector o -1 si no existe */
int buscarProductoPorId(int id) {
    int i;
    for (i = 0; i < cantProductos; i++)
        if (productos[i].id == id)
            return i;
    return -1;
}

void altaProducto(void) {
    Producto p;

    if (cantProductos >= MAX_PRODUCTOS) {
        printf("No hay espacio para mas productos (maximo %d).\n", MAX_PRODUCTOS);
        return;
    }

    printf("\n--- ALTA DE PRODUCTO ---\n");

    do {
        leerTexto("Nombre del producto: ", p.nombre, 40);
        if (strlen(p.nombre) == 0)
            printf("El nombre no puede estar vacio.\n");
    } while (strlen(p.nombre) == 0);

    p.tipo      = leerEntero("Tipo (1-Pizza 2-Bebida 3-Postre 4-Combo): ", 1, 4);
    p.precio    = leerEntero("Precio en pesos: ", 1, 1000000);
    p.disponible = 1;
    p.id        = siguienteIdProducto;

    productos[cantProductos] = p;
    cantProductos++;
    siguienteIdProducto++;

    printf("Producto dado de alta correctamente. ID asignado: %d\n", p.id);
}

void modificarPrecio(void) {
    int id, idx, nuevo;

    if (cantProductos == 0) {
        printf("No hay productos cargados.\n");
        return;
    }

    mostrarProductos();
    printf("\n--- MODIFICAR PRECIO ---\n");

    do {
        id = leerEntero("ID del producto a modificar (0 para cancelar): ", 0, 999999);
        if (id == 0) return;
        idx = buscarProductoPorId(id);
        if (idx == -1)
            printf("No existe un producto con ID %d.\n", id);
    } while (idx == -1);

    printf("Producto : %s\n", productos[idx].nombre);
    printf("Precio actual: $%d\n", productos[idx].precio);

    nuevo = leerEntero("Nuevo precio: ", 1, 1000000);
    productos[idx].precio = nuevo;

    printf("Precio actualizado a $%d.\n", productos[idx].precio);
}

void bajaLogicaProducto(void) {
    int id, idx;

    if (cantProductos == 0) {
        printf("No hay productos cargados.\n");
        return;
    }

    mostrarProductos();
    printf("\n--- BAJA DE PRODUCTO ---\n");

    do {
        id = leerEntero("ID del producto a dar de baja (0 para cancelar): ", 0, 999999);
        if (id == 0) return;
        idx = buscarProductoPorId(id);
        if (idx == -1)
            printf("No existe un producto con ID %d.\n", id);
    } while (idx == -1);

    productos[idx].disponible = 0;
    printf("Producto \"%s\" dado de baja (ya no figura en la carta).\n",
           productos[idx].nombre);
}

